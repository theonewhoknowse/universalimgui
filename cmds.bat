@echo off
setlocal

REM Build the PC-side plugin bundle before starting Frida.
powershell -NoProfile -ExecutionPolicy Bypass -Command "$files=Get-ChildItem -LiteralPath 'plugins' -Filter '*.js' -File -ErrorAction SilentlyContinue; $out='// Generated by cmds.bat. Do not edit.\n'; $out+='(globalThis).__universalimguiPluginFiles = {};\n'; foreach($f in $files){$name=$f.Name -replace '\\','\\\\' -replace '"','\"'; $code=[IO.File]::ReadAllText($f.FullName); $json=$code|ConvertTo-Json -Compress; $out+='(globalThis).__universalimguiPluginFiles["'+$name+'"] = '+$json+';\n'}; [IO.File]::WriteAllText('plugin_bundle.js',$out,(New-Object Text.UTF8Encoding($false)))"

frida -U -l frida-il2cpp-bridge.js -l plugin_bundle.js -l script.ts "Newton's Playground"

endlocal
